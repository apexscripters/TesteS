-- Button
Button = setmetatable({}, ApexComponent)
Button.__index = Button

function Button.new(config, section)
    local self = setmetatable(ApexComponent.new(config), Button)
    self.Type = "Button"
    self.ParentSection = section
    self.Icon = config.Icon or nil
    self.Loading = false
    self._container = CreateComponentContainer(section, 40)
    self._maid:give(self._container)
    table.insert(section.Components, self)

    local labelArea = CreateLabelArea(self._container, self.Name, self.Description)
    labelArea.Size = UDim2.new(0, 120, 1, 0)
    labelArea.LayoutOrder = 1

    local button = UIBuilder.CreateTextButton(self._container, {
        Size = UDim2.new(0, 80, 0, 30),
        Position = UDim2.new(1, -90, 0.5, -15),
        Text = self.Name,
        Font = ThemeEngine.Current.FontBold,
        TextSize = 12,
        TextColor3 = Color3.new(1,1,1),
        BackgroundColor3 = ThemeEngine.Current.Accent,
        BackgroundTransparency = 0,
        AutoButtonColor = false,
        LayoutOrder = 2,
    })
    UIBuilder.CreateUICorner(button, 6)
    self._button = button
    self._maid:give(button)

    if self.Icon then
        button.Text = IconService.GetIcon(self.Icon) .. " " .. self.Name
    end

    button.MouseButton1Click:Connect(function()
        if self.Enabled and not self.Loading then
            self:_execute()
        end
    end)
    self._maid:give(button.MouseButton1Click)

    button.MouseEnter:Connect(function()
        if self.Enabled then
            AnimationEngine.Tween(button, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = ThemeEngine.Current.AccentHover})
        end
    end)
    button.MouseLeave:Connect(function()
        if self.Enabled then
            AnimationEngine.Tween(button, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = ThemeEngine.Current.Accent})
        end
    end)

    if self.Tooltip then
        self:_addTooltip(button)
    end

    return self
end

function Button:_execute()
    if self.Callback then
        self:SetLoading(true)
        task.spawn(function()
            local success, err = pcall(self.Callback)
            if not success then
                DebugService.Error("Button callback error: " .. tostring(err))
            end
            self:SetLoading(false)
        end)
    end
end

function Button:SetText(text)
    self.Name = text
    if self.Icon then
        self._button.Text = IconService.GetIcon(self.Icon) .. " " .. text
    else
        self._button.Text = text
    end
end

function Button:SetDescription(desc)
    self.Description = desc
    -- Não temos referência ao label de descrição, mas podemos aceitar
end

function Button:SetIcon(icon)
    self.Icon = icon
    if self.Icon then
        self._button.Text = IconService.GetIcon(self.Icon) .. " " .. self.Name
    else
        self._button.Text = self.Name
    end
end

function Button:SetEnabled(enabled)
    ApexComponent.SetEnabled(self, enabled)
    self._button.AutoButtonColor = false
    if enabled then
        self._button.BackgroundColor3 = ThemeEngine.Current.Accent
        self._button.TextColor3 = Color3.new(1,1,1)
    else
        self._button.BackgroundColor3 = Color3.fromRGB(100,100,100)
        self._button.TextColor3 = Color3.fromRGB(180,180,180)
    end
end

function Button:SetLoading(loading)
    self.Loading = loading
    if loading then
        self._button.Text = "Loading..."
        self._button.BackgroundColor3 = ThemeEngine.Current.Warning
        self._button.AutoButtonColor = false
    else
        self:SetText(self.Name)
        self:SetEnabled(self.Enabled)
    end
end

function Button:_addTooltip(instance)
    local tooltip = UIBuilder.CreateTextLabel(instance.Parent, {
        Size = UDim2.new(0, 100, 0, 20),
        Position = UDim2.new(0, 0, 0, 0),
        Text = self.Tooltip,
        Font = ThemeEngine.Current.Font,
        TextSize = 10,
        TextColor3 = ThemeEngine.Current.Text,
        BackgroundColor3 = Color3.fromRGB(0,0,0),
        BackgroundTransparency = 0.2,
        Visible = false,
        ZIndex = 20,
    })
    UIBuilder.CreateUICorner(tooltip, 4)
    self._maid:give(tooltip)
    instance.MouseEnter:Connect(function()
        tooltip.Visible = true
        local abs = instance.AbsolutePosition
        tooltip.Position = UDim2.new(0, abs.X - instance.Parent.AbsolutePosition.X, 0, abs.Y - instance.Parent.AbsolutePosition.Y - 20)
    end)
    instance.MouseLeave:Connect(function()
        tooltip.Visible = false
    end)
end

