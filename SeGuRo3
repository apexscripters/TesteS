    local toggleButton = UIBuilder.CreateTextButton(self._container, {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -50, 0.5, -10),
        Text = "",
        BackgroundColor3 = ThemeEngine.Current.SurfaceSecondary,
        BackgroundTransparency = 0.3,
        AutoButtonColor = false,
        LayoutOrder = 2,
    })
    UIBuilder.CreateUICorner(toggleButton, 10)
    local toggleKnob = UIBuilder.CreateFrame(toggleButton, {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = ThemeEngine.Current.TextSecondary,
        BackgroundTransparency = 0,
