        -- Detiene el arrastre de la interfaz principal
        dragging = false

        -- Si el boton flotante no se movio se trata como clic y abre la GUI
        if floatDragging then
            if not floatMoved then
                mainFrame.Visible = true
                floatBtn.Visible  = false
            end
            floatDragging = false
            floatMoved    = false
        end
    end
end)

-- Mueve la GUI principal o el boton flotante segun cual se esta arrastrando
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local pos = Vector2.new(input.Position.X, input.Position.Y)

        -- Arrastre de la interfaz principal siguiendo el cursor
        if dragging and dragStart and frameStart then
            local delta = pos - dragStart
            mainFrame.Position = UDim2.new(
                0, frameStart.X.Offset + delta.X,
                0, frameStart.Y.Offset + delta.Y
            )
        end

        -- Arrastre del boton flotante con limites de pantalla para no salir
        if floatDragging and floatDragStart and floatBtnStart then
            local delta = pos - floatDragStart
            if delta.Magnitude > DRAG_THRESHOLD then
                floatMoved = true
            end
            if floatMoved then
                local screen  = Workspace.CurrentCamera.ViewportSize
                local btnSize = floatBtn.AbsoluteSize
                local newX = math.clamp(floatBtnStart.X.Offset + delta.X, 0, screen.X - btnSize.X)
                local newY = math.clamp(floatBtnStart.Y.Offset + delta.Y, 0, screen.Y - btnSize.Y)
                floatBtn.Position = UDim2.new(0, newX, 0, newY)
            end
        end
    end
end)

-- Busca en el workspace la parte de la caminadora mas cercana a la posicion dada
local function findTreadmillPart(pos)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if string.find(n, "treadmill") or string.find(n, "esteira") then
                if (obj.Position - pos).Magnitude <= 10 then
                    return obj
                end
            end
        end
    end
    return nil
end

-- Detiene el farm desconectando el Heartbeat y el listener de fuerza
local function stopFarming()
    stopRequested = true
    if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
    if strengthConn  then strengthConn:Disconnect();  strengthConn  = nil end
end

-- Cambia el aspecto visual del boton segun si el farm esta activo o detenido
local function setToggleState(running)
    if running then
        toggleGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, C.red),
            ColorSequenceKeypoint.new(1, C.redDark),
        })
        toggleIcon.Text = "■"
        toggleText.Text = "PARAR FARM"
        pulseTween = pulseToggle(true)
    else
        if pulseTween then pulseTween:Cancel(); pulseTween = nil end
        toggleBtn.BackgroundTransparency = 0
        toggleGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, C.green),
            ColorSequenceKeypoint.new(1, C.greenDark),
        })
        toggleIcon.Text = "▶"
        toggleText.Text = "INICIAR FARM"
    end
end

-- Inicia o detiene el farm dependiendo del estado actual
local function toggleFarming()

    -- Detiene el farm activo y restaura el movimiento del personaje
    if isRunning then
        stopFarming()
        local char = player.Character
        if char then
            local hum  = char:FindFirstChild("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum  then hum.AutoRotate = true end
            if root then root.AssemblyLinearVelocity = Vector3.zero end
        end
        targetCFrameGlobal = nil
        isRunning = false
        setToggleState(false)
        setStatus("Farm parado", C.red)
        return
    end

    -- Inicia el farm validando XP y ubicando al personaje en la caminadora
    isRunning     = true
    stopRequested = false

    local gains = tonumber(xpInput.Text)
    if not gains or gains <= 0 then
        gains = DEFAULT_GAINS
        xpInput.Text = tostring(DEFAULT_GAINS)
    end

    setToggleState(true)
    setStatus("Localizando esteira...", Color3.fromRGB(255, 200, 50))

    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        setStatus("Personagem não encontrado", C.red)
        isRunning = false
        setToggleState(false)
        return
    end

    local humanoid = char:WaitForChild("Humanoid")
    local rootPart = char:WaitForChild("HumanoidRootPart")

    -- Lee la caminadora seleccionada y su rotacion especifica
    local data          = treadmillData[selectedIndex]
    local rotY          = data.rotY or 180
    local treadmillPart = findTreadmillPart(data.pos)
    local targetCFrame

    -- Calcula el CFrame con la rotacion correcta segun la caminadora elegida
    if treadmillPart then
        targetCFrame = treadmillPart.CFrame
            * CFrame.Angles(0, math.rad(rotY), 0)
            * CFrame.new(0, humanoid.HipHeight + OFFSET_Y, 0)
    else
        local fallbackPos = data.pos + Vector3.new(0, humanoid.HipHeight + OFFSET_Y, 0)
        targetCFrame = CFrame.new(fallbackPos, fallbackPos + Vector3.new(0, 0, -1))
    end

    targetCFrameGlobal  = targetCFrame
    rootPart.CFrame     = targetCFrame
    humanoid.AutoRotate = false
    task.wait(0.1)

    -- Busca el stat de fuerza en los leaderstats del jugador
    local leaderstats = player:FindFirstChild("leaderstats") or player:FindFirstChild("PlayerStats")
    local strength    = leaderstats and (
        leaderstats:FindFirstChild("Strength") or leaderstats:FindFirstChild("Power")
    )

    if not strength then
        setStatus("Stats não encontrados", C.red)
        humanoid.AutoRotate = true
        isRunning = false
        setToggleState(false)
        return
    end

    lastStrengthValue = strength.Value
    local xpCount     = 0

    -- Escucha los cambios en la fuerza para contar cada XP ganado
    strengthConn = strength:GetPropertyChangedSignal("Value"):Connect(function()
        if not isRunning or stopRequested then return end
        local newVal = strength.Value
        if newVal > lastStrengthValue then
            xpCount += 1
            lastStrengthValue = newVal
            setStatus(string.format("XP ganho: %d / %d", xpCount, gains), C.green)
            -- Detiene automaticamente el farm al alcanzar el objetivo de XP
            if xpCount >= gains then
                stopFarming()
                local c = player.Character
                if c then
                    local hum2  = c:FindFirstChild("Humanoid")
                    local root2 = c:FindFirstChild("HumanoidRootPart")
                    if hum2  then hum2.AutoRotate = true end
                    if root2 then root2.AssemblyLinearVelocity = Vector3.zero end
                end
                targetCFrameGlobal = nil
                isRunning = false
                setToggleState(false)
                setStatus("✓ Concluído! " .. xpCount .. " XP ganhos", C.green)
            end
        end
        lastStrengthValue = newVal
    end)

    -- Mantiene el personaje fijo sobre la caminadora en cada frame del juego
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not isRunning or stopRequested then return end
        local c = player.Character
        if not c then return end
        local root2 = c:FindFirstChild("HumanoidRootPart")
        local hum2  = c:FindFirstChild("Humanoid")
        if not root2 or not hum2 then return end
        root2.CFrame = targetCFrameGlobal
        hum2:Move(root2.CFrame.LookVector, true)
        hum2.WalkSpeed = 16
    end)

    setStatus(string.format("Correndo — meta: %d XP", gains), C.green)
end

-- Conecta el boton principal con la funcion que inicia o detiene el farm
toggleBtn.MouseButton1Click:Connect(toggleFarming)

-- Detiene el farm automaticamente si el personaje muere o reaparece
player.CharacterAdded:Connect(function()
    if isRunning then
        stopFarming()
        isRunning          = false
        targetCFrameGlobal = nil
        setToggleState(false)
        setStatus("Respawnado — farm pausado", C.red)
    end
end)
