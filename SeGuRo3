function Window:Destroy()
    if self._closed then return end
    self._maid:destroy()
    if self._gui then self._gui:Destroy() end
    for i, w in ipairs(Apex._windows) do
        if w == self then
            table.remove(Apex._windows, i)
            break
        end
    end
    Apex.Signals.WindowChanged:fire(self, "Destroyed")
    Apex.Signals.Destroyed:fire(self)
    DebugService.Log("INFO", "Window destroyed: " .. self.Id)
end

