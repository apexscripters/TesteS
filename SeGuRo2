-- Ajusta la ruleta al item mas cercano despues de soltar el scroll
local function snapRoller()
    local rawY         = rollerScroll.CanvasPosition.Y
    local snappedIndex = math.clamp(math.round(rawY / ITEM_HEIGHT) + 1, 1, #treadmillData)
    selectedIndex      = snappedIndex
    TweenService:Create(rollerScroll, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CanvasPosition = Vector2.new(0, (snappedIndex - 1) * ITEM_HEIGHT)
    }):Play()
end

-- Detecta cuando se suelta el scroll para aplicar el ajuste de posicion
rollerScroll.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        task.delay(0.05, snapRoller)
    end
end)

