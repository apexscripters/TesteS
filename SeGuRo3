function Window:SetPosition(position)
    if type(position) == "UDim2" then
        self.Position = position
        self._mainFrame.Position = position
    elseif type(position) == "table" then
        local pos = UDim2.new(position.X or 0, position.XOffset or 0, position.Y or 0, position.YOffset or 0)
        self:SetPosition(pos)
    end
end

function Window:SetSize(width, height)
    self.Width = width
    self.Height = height
    self._mainFrame.Size = UDim2.new(0, width, 0, height)
    self._handleResize()
end

function Window:Open()
    self._closed = false
    self._gui.Enabled = true
    self._mainFrame.Visible = true
    self.Visible = true
    Apex.Signals.VisibilityChanged:fire(self, true)
    Apex.Signals.WindowChanged:fire(self, "Opened")
    if not self.Minimized then
        AnimationEngine.Tween(self._mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = ThemeEngine.Current.Transparency.Window, Size = UDim2.new(0, self.Width, 0, self.Height)})
    end
end

function Window:Close()
    self._closed = true
    self._gui.Enabled = false
    self._mainFrame.Visible = false
    self.Visible = false
    Apex.Signals.VisibilityChanged:fire(self, false)
    Apex.Signals.WindowChanged:fire(self, "Closed")
end

function Window:Toggle()
    if self._closed then
        self:Open()
    else
        self:Close()
    end
end

function Window:Minimize()
    if self.Minimized then return end
    self.Minimized = true
    self._minimizedOriginalPos = self._mainFrame.Position
    local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or game:GetService("GuiService"):GetScreenResolution()
    local newY = viewport.Y - 50
    self._mainFrame:TweenPosition(UDim2.new(self._mainFrame.Position.X.Scale, self._mainFrame.Position.X.Offset, 0, newY), "Out", "Quad", 0.3, true)
    self._content.Visible = false
    self._sidebar.Visible = false
    self._header.Visible = true
    self._mainFrame.Size = UDim2.new(0, self.Width, 0, 50)
    -- Add restore button
    if not self._restoreButton then
        self._restoreButton = UIBuilder.CreateTextButton(self._header, {
            Size = UDim2.new(0, 80, 0, 40),
            Position = UDim2.new(0, 50, 0, 5),
            Text = "Restore",
            Font = ThemeEngine.Current.Font,
            TextSize = 12,
            TextColor3 = Color3.new(1,1,1),
            BackgroundColor3 = ThemeEngine.Current.Accent,
            BackgroundTransparency = 0,
            AutoButtonColor = false,
        })
        UIBuilder.CreateUICorner(self._restoreButton, 6)
        self._maid:give(self._restoreButton.MouseButton1Click:Connect(function()
            self:Restore()
        end))
        self._maid:give(self._restoreButton)
    end
    self._restoreButton.Visible = true
    Apex.Signals.WindowChanged:fire(self, "Minimized")
end

function Window:Restore()
    if not self.Minimized then return end
    self.Minimized = false
    self._mainFrame.Size = UDim2.new(0, self.Width, 0, self.Height)
    self._mainFrame.Position = self._minimizedOriginalPos or UDim2.new(0.5, -self.Width/2, 0.5, -self.Height/2)
    self._content.Visible = true
    self._sidebar.Visible = true
    if self._restoreButton then
        self._restoreButton.Visible = false
    end
    Apex.Signals.WindowChanged:fire(self, "Restored")
end

function Window:Maximize()
    if self.Maximized then
        -- Restore
        self.Maximized = false
        if self._maximizedOriginalSize then
            self._mainFrame.Size = self._maximizedOriginalSize
            self._maximizedOriginalSize = nil
        end
        self._content.Visible = true
        self._sidebar.Visible = true
        Apex.Signals.WindowChanged:fire(self, "Restored")
    else
        self.Maximized = true
        self._maximizedOriginalSize = self._mainFrame.Size
        local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or game:GetService("GuiService"):GetScreenResolution()
        self._mainFrame.Size = UDim2.new(1, -20, 1, -20)
        self._mainFrame.Position = UDim2.new(0, 10, 0, 10)
        self._content.Visible = true
        self._sidebar.Visible = true
        self._header.Visible = true
        Apex.Signals.WindowChanged:fire(self, "Maximized")
    end
end

function Window:SetVisible(visible)
    if visible then
        self:Open()
    else
        self:Close()
    end
end

function Window:CreateTab(config)
    local tab = Tab.new(config, self)
    table.insert(self._tabs, tab)
    if #self._tabs == 1 then
        self:SelectTab(tab)
    end
    return tab
end

function Window:SelectTab(tab)
    if self._activeTab == tab then return end
    self._activeTab = tab
    for _, t in ipairs(self._tabs) do
        t:_setActive(t == tab)
        for _, section in ipairs(t.Sections) do
            section._container.Visible = (t == tab)
        end
    end
    Apex.Signals.TabChanged:fire(self, tab)
    DebugService.Log("INFO", "Tab selected: " .. tab.Name)
end

