function Tab.new(config, parentWindow)
    local self = setmetatable({}, Tab)
    self.Id = config.Id or Registry.GenerateId("tab")
    self.Name = config.Name or "Tab"
    self.Icon = config.Icon or nil
    self.ParentWindow = parentWindow
    self.Sections = {}
    self.Active = false
    self.Visible = true
    self._container = nil
    self._button = nil
    self._indicator = nil
    self._maid = Utilities.Maid.new()

    local button = UIBuilder.CreateTextButton(parentWindow._sidebar, {
        Size = UDim2.new(1, 0, 0, 36),
        Text = self.Name,
        Font = ThemeEngine.Current.Font,
        TextSize = 14,
        TextColor3 = ThemeEngine.Current.TextSecondary,
        BackgroundColor3 = ThemeEngine.Current.SurfaceSecondary,
        BackgroundTransparency = ThemeEngine.Current.Transparency.Component,
        AutoButtonColor = false,
        LayoutOrder = #parentWindow._tabs + 1,
    })
    UIBuilder.CreateUICorner(button, 6)
    self._button = button
    self._maid:give(button)

    local indicator = UIBuilder.CreateFrame(button, {
        Size = UDim2.new(0, 3, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = ThemeEngine.Current.Accent,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Visible = false,
    })
    UIBuilder.CreateUICorner(indicator, 2)
    self._indicator = indicator
    self._maid:give(indicator)

    if self.Icon then
        local iconLabel = UIBuilder.CreateTextLabel(button, {
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(0, 8, 0.5, -10),
            Text = IconService.GetIcon(self.Icon) or self.Icon,
            Font = Enum.Font.GothamBold,
            TextSize = 16,
            TextColor3 = ThemeEngine.Current.TextSecondary,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextYAlignment = Enum.TextYAlignment.Center,
        })
        self._iconLabel = iconLabel
        self._maid:give(iconLabel)
        button.TextXAlignment = Enum.TextXAlignment.Left
        button.Position = UDim2.new(0, 30, 0, 0)
        button.Size = UDim2.new(1, -30, 0, 36)
    end

    button.MouseButton1Click:Connect(function()
        parentWindow:SelectTab(self)
    end)

    return self
end

function Tab:_setActive(active)
    self.Active = active
    if self._indicator then
        self._indicator.Visible = active
    end
    if self._button then
        if active then
            self._button.BackgroundColor3 = ThemeEngine.Current.Accent
            self._button.BackgroundTransparency = 0
            self._button.TextColor3 = Color3.new(1,1,1)
        else
            self._button.BackgroundColor3 = ThemeEngine.Current.SurfaceSecondary
            self._button.BackgroundTransparency = ThemeEngine.Current.Transparency.Component
            self._button.TextColor3 = ThemeEngine.Current.TextSecondary
        end
        if self._iconLabel then
            if active then
                self._iconLabel.TextColor3 = Color3.new(1,1,1)
            else
                self._iconLabel.TextColor3 = ThemeEngine.Current.TextSecondary
            end
        end
    end
end

function Tab:CreateSection(config)
    local section = Section.new(config, self)
    table.insert(self.Sections, section)
    return section
end

function Tab:Select()
    self.ParentWindow:SelectTab(self)
end

function Tab:SetName(name)
    self.Name = name
    self._button.Text = name
    Apex.Signals.TabChanged:fire(self.ParentWindow, self, "NameChanged")
end

function Tab:SetIcon(icon)
    self.Icon = icon
    if self._iconLabel then
        self._iconLabel.Text = IconService.GetIcon(icon) or icon
    else
        local iconLabel = UIBuilder.CreateTextLabel(self._button, {
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(0, 8, 0.5, -10),
            Text = IconService.GetIcon(icon) or icon,
            Font = Enum.Font.GothamBold,
            TextSize = 16,
            TextColor3 = self.Active and Color3.new(1,1,1) or ThemeEngine.Current.TextSecondary,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextYAlignment = Enum.TextYAlignment.Center,
        })
        self._iconLabel = iconLabel
        self._maid:give(iconLabel)
        self._button.TextXAlignment = Enum.TextXAlignment.Left
        self._button.Position = UDim2.new(0, 30, 0, 0)
        self._button.Size = UDim2.new(1, -30, 0, 36)
    end
end

function Tab:SetVisible(visible)
    self.Visible = visible
    self._button.Visible = visible
    if not visible and self.Active then
        for _, t in ipairs(self.ParentWindow._tabs) do
            if t.Visible and t ~= self then
                self.ParentWindow:SelectTab(t)
                break
            end
        end
    end
end

function Tab:Destroy()
    self._maid:destroy()
    if self._button then self._button:Destroy() end
    for i, t in ipairs(self.ParentWindow._tabs) do
        if t == self then
            table.remove(self.ParentWindow._tabs, i)
            break
        end
    end
    if self.ParentWindow._activeTab == self then
        self.ParentWindow._activeTab = nil
        if #self.ParentWindow._tabs > 0 then
            self.ParentWindow:SelectTab(self.ParentWindow._tabs[1])
        end
    end
    Apex.Signals.TabChanged:fire(self.ParentWindow, self, "Destroyed")
end

