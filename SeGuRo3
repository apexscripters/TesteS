local Utilities = {}
Utilities.Maid = {}
Utilities.Maid.__index = Utilities.Maid

function Utilities.Maid.new()
    local self = setmetatable({}, Utilities.Maid)
    self._tasks = {}
    return self
end

function Utilities.Maid:give(task)
    table.insert(self._tasks, task)
    return task
end

function Utilities.Maid:cleanup()
    for _, task in ipairs(self._tasks) do
        if type(task) == "function" then
            task()
        elseif type(task) == "userdata" and task.Disconnect then
            task:Disconnect()
        elseif type(task) == "table" and task.Destroy then
            task:Destroy()
        end
    end
    self._tasks = {}
end

function Utilities.Maid:destroy()
    self:cleanup()
    setmetatable(self, nil)
end

Utilities.Signal = {}
Utilities.Signal.__index = Utilities.Signal

function Utilities.Signal.new()
    local self = setmetatable({}, Utilities.Signal)
    self._connections = {}
    return self
end

function Utilities.Signal:connect(callback)
    local conn = {
        Connected = true,
        Disconnect = function()
            if conn.Connected then
                conn.Connected = false
                for i, c in ipairs(self._connections) do
                    if c == conn then
                        table.remove(self._connections, i)
                        break
                    end
                end
            end
        end
    }
    conn.Callback = callback
    table.insert(self._connections, conn)
    return conn
end

function Utilities.Signal:fire(...)
    local args = {...}
    for _, conn in ipairs(self._connections) do
        if conn.Connected then
            task.spawn(conn.Callback, unpack(args))
        end
    end
end

function Utilities.Signal:disconnectAll()
    for _, conn in ipairs(self._connections) do
        conn:Disconnect()
    end
    self._connections = {}
end

Utilities.Types = {
    Validate = function(value, expectedType)
        if expectedType == "string" then return type(value) == "string"
        elseif expectedType == "number" then return type(value) == "number"
        elseif expectedType == "boolean" then return type(value) == "boolean"
        elseif expectedType == "function" then return type(value) == "function"
        elseif expectedType == "table" then return type(value) == "table"
        elseif expectedType == "Color3" then return typeof(value) == "Color3"
        elseif expectedType == "EnumItem" then return typeof(value) == "EnumItem"
        else return true end
    end,
    Optional = function(value, default)
        return value ~= nil and value or default
    end,
    Clamp = function(value, min, max)
        return math.clamp(value, min, max)
    end,
}

Utilities.Math = {
    Round = function(num, increment)
        if increment and increment > 0 then
            return math.floor(num / increment + 0.5) * increment
        end
        return math.floor(num + 0.5)
    end,
    Lerp = function(a, b, t)
        return a + (b - a) * t
    end,
}

Utilities.Tables = {
    Copy = function(tbl)
        local copy = {}
        for k, v in pairs(tbl) do
            if type(v) == "table" then
                copy[k] = Utilities.Tables.Copy(v)
            else
                copy[k] = v
            end
        end
        return copy
    end,
    Merge = function(...)
        local result = {}
        for _, tbl in ipairs({...}) do
            for k, v in pairs(tbl) do
                result[k] = v
            end
        end
        return result
    end,
}

Utilities.InstanceHelpers = {
    Create = function(className, properties)
        local instance = Instance.new(className)
        for prop, value in pairs(properties or {}) do
            instance[prop] = value
        end
        return instance
    end,
    ApplyProps = function(instance, props)
        for prop, value in pairs(props or {}) do
            instance[prop] = value
        end
        return instance
    end,
    ClearChildren = function(parent)
        for _, child in ipairs(parent:GetChildren()) do
            child:Destroy()
        end
    end,
}

