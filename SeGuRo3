        TextColor3 = ThemeEngine.Current.Text,
        BackgroundColor3 = ThemeEngine.Current.SurfaceSecondary,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 2,
        Parent = self._container,
    })
    UIBuilder.CreateUICorner(textBox, 6)
    self._textBox = textBox
    self._maid:give(textBox)

    textBox:GetPropertyChangedSignal("Text"):Connect(function()
        if string.len(textBox.Text) > self.MaxChars then
            textBox.Text = string.sub(textBox.Text, 1, self.MaxChars)
        end
        if self.Numeric and not tonumber(textBox.Text) and textBox.Text ~= "" then
            textBox.Text = string.gsub(textBox.Text, "[^%d%.%-]", "")
        end
        self.Value = textBox.Text
    end)

    textBox.FocusLost:Connect(function(enterPressed)
        if enterPressed or not self.SubmitMode then
            self:Submit()
        end
    end)
    self._maid:give(textBox.FocusLost)

    return self
end

