function ColorPicker:OpenColorPicker()
    local rootGui = self.ParentSection.ParentTab.ParentWindow._gui
    local pickerFrame = UIBuilder.CreateFrame(rootGui, {
        Size = UDim2.new(0, 260, 0, 180),
        Position = UDim2.new(0, self._colorButton.AbsolutePosition.X, 0, self._colorButton.AbsolutePosition.Y + 30),
        BackgroundColor3 = ThemeEngine.Current.Surface,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        ZIndex = 20,
        ClipsDescendants = true,
    })
    UIBuilder.CreateUICorner(pickerFrame, 8)

    -- Simples: três sliders para RGB
    local rSlider = self:CreateColorSlider(pickerFrame, "R", 10, self.Value.R)
    local gSlider = self:CreateColorSlider(pickerFrame, "G", 40, self.Value.G)
    local bSlider = self:CreateColorSlider(pickerFrame, "B", 70, self.Value.B)

    local preview = UIBuilder.CreateFrame(pickerFrame, {
        Size = UDim2.new(0, 60, 0, 60),
        Position = UDim2.new(0, 190, 0, 10),
        BackgroundColor3 = self.Value,
        BorderSizePixel = 0,
    })
    UIBuilder.CreateUICorner(preview, 8)

    local function updateFromSliders()
        local newColor = Color3.new(rSlider.Value, gSlider.Value, bSlider.Value)
        self:SetValue(newColor)
        preview.BackgroundColor3 = newColor
    end

    rSlider.Slider:SetCallback(updateFromSliders)
    gSlider.Slider:SetCallback(updateFromSliders)
    bSlider.Slider:SetCallback(updateFromSliders)

    self._maid:give(pickerFrame)

    local connection
    connection = game:GetService("UserInputService").InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if pickerFrame and not pickerFrame:IsDescendantOf(input.Position) then
                pickerFrame:Destroy()
                if connection then connection:Disconnect() end
            end
        end
    end)
    self._maid:give(connection)
end

function ColorPicker:CreateColorSlider(parent, label, y, initial)
    local sliderFrame = UIBuilder.CreateFrame(parent, {
        Size = UDim2.new(1, -20, 0, 30),
        Position = UDim2.new(0, 10, 0, y),
        BackgroundTransparency = 1,
    })
    local label = UIBuilder.CreateTextLabel(sliderFrame, {
        Size = UDim2.new(0, 20, 0, 20),
        Text = label,
        Font = ThemeEngine.Current.FontBold,
        TextSize = 12,
        TextColor3 = ThemeEngine.Current.Text,
    })
    local slider = {}
    local bg = UIBuilder.CreateFrame(sliderFrame, {
        Size = UDim2.new(1, -30, 0, 10),
        Position = UDim2.new(0, 25, 0.5, -5),
        BackgroundColor3 = ThemeEngine.Current.SurfaceSecondary,
        BackgroundTransparency = 0.4,
    })
    UIBuilder.CreateUICorner(bg, 5)
    local fill = UIBuilder.CreateFrame(bg, {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = ThemeEngine.Current.Accent,
    })
    UIBuilder.CreateUICorner(fill, 5)
    local knob = UIBuilder.CreateFrame(bg, {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, -8, 0.5, -8),
        BackgroundColor3 = Color3.new(1,1,1),
    })
    UIBuilder.CreateUICorner(knob, 8)

    local function update(input)
        local relX = (input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X
        relX = math.clamp(relX, 0, 1)
        local value = relX
        fill.Size = UDim2.new(relX, 0, 1, 0)
        knob.Position = UDim2.new(relX, -8, 0.5, -8)
        slider.Value = value
        if slider.Callback then slider.Callback(value) end
    end

    local dragging = false
    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    bg.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    bg.InputEnded:Connect(function(input)
        dragging = false
    end)

    -- inicial
    slider.Value = initial
    fill.Size = UDim2.new(initial, 0, 1, 0)
    knob.Position = UDim2.new(initial, -8, 0.5, -8)
    slider.Slider = slider
    return slider
end

function ColorPicker:SetValue(color)
    self.Value = color
    if self._colorButton then
        self._colorButton.BackgroundColor3 = color
    end
    if self.Callback then
        task.spawn(self.Callback, color)
