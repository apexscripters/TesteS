local ConfigService = {
    AutoSave = false,
    AutoSaveInterval = 30,
    Configs = {},
    SaveFunction = nil,
    LoadFunction = nil,
}

function Apex.Config:Save(name)
    local data = {}
    for id, comp in pairs(Registry.GetAll()) do
        if comp.ParentSection then
            data[id] = {
                Type = comp.Type,
                Value = comp.Value,
            }
        end
    end
    data["_uiState"] = {
        theme = Apex:GetTheme(),
        scale = Apex._scale,
    }
    ConfigService.Configs[name] = data
    if ConfigService.SaveFunction then
        ConfigService.SaveFunction(name, data)
    end
    DebugService.Log("INFO", "Config saved: " .. name)
    return true
end

function Apex.Config:Load(name)
    local data = ConfigService.Configs[name]
    if not data and ConfigService.LoadFunction then
        data = ConfigService.LoadFunction(name)
    end
    if data then
        for id, compData in pairs(data) do
            if id ~= "_uiState" then
                local comp = Registry.Find(id)
                if comp then
                    comp:SetValue(compData.Value)
                end
            end
        end
        if data._uiState then
            if data._uiState.theme then
                Apex:SetTheme(data._uiState.theme)
            end
            if data._uiState.scale then
                Apex:SetScale(data._uiState.scale)
            end
        end
        DebugService.Log("INFO", "Config loaded: " .. name)
        return true
    end
    return false
end

function Apex.Config:Delete(name)
    ConfigService.Configs[name] = nil
    if ConfigService.SaveFunction then
        ConfigService.SaveFunction(name, nil)
    end
    return true
end

function Apex.Config:Exists(name)
    return ConfigService.Configs[name] ~= nil
end

function Apex.Config:List()
    local names = {}
    for name, _ in pairs(ConfigService.Configs) do
        table.insert(names, name)
    end
    return names
end

function Apex.Config:SetAutoSave(enabled)
    ConfigService.AutoSave = enabled
    if ConfigService.AutoSaveTimer then
        ConfigService.AutoSaveTimer:Disconnect()
        ConfigService.AutoSaveTimer = nil
    end
    if enabled then
        task.spawn(function()
            while ConfigService.AutoSave do
                task.wait(ConfigService.AutoSaveInterval)
                Apex.Config:Save("AutoSave")
            end
        end)
    end
end

function Apex.Config:SetAutoSaveInterval(interval)
    ConfigService.AutoSaveInterval = interval
    if ConfigService.AutoSave then
        ConfigService:SetAutoSave(true) -- reinicia
    end
end

function Apex.Config:SetSaveFunction(func)
    ConfigService.SaveFunction = func
end

function Apex.Config:SetLoadFunction(func)
    ConfigService.LoadFunction = func
end

-- ///////////////////////////////
-- // EXTENSION API
-- ///////////////////////////////

function Apex:RegisterComponent(name, factory)
    if type(factory) == "function" then
        self._customComponents[name] = factory
        return true
    end
    return false
end

-- ///////////////////////////////
-- // PUBLIC API: CREATE WINDOW
-- ///////////////////////////////

function Apex:CreateWindow(config)
    config = config or {}
    local window = Window.new(config)
    return window
end

-- ///////////////////////////////
-- // INITIALIZATION
-- ///////////////////////////////

ResponsiveEngine.DetectDevice()
ResponsiveEngine.Scale = ResponsiveEngine.CalculateScale()
Apex:SetTheme(ThemeEngine.DefaultTheme)

return Apex
