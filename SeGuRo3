local Registry = {
    Components = {},
    NextId = 1,
}

function Registry.GenerateId(prefix)
    local id = prefix .. "_" .. tostring(Registry.NextId)
    Registry.NextId = Registry.NextId + 1
    return id
end

function Registry.Register(component)
    Registry.Components[component.Id] = component
    Apex._components[component.Id] = component
end

function Registry.Unregister(component)
    Registry.Components[component.Id] = nil
    Apex._components[component.Id] = nil
end

function Registry.Find(id)
    return Registry.Components[id]
end

function Registry.GetAll()
    return Registry.Components
end

-- ///////////////////////////////
-- // COMPONENT BASE CLASS
-- ///////////////////////////////

local ApexComponent = {}
ApexComponent.__index = ApexComponent

function ApexComponent.new(config)
    local self = setmetatable({}, ApexComponent)
    self.Id = config.Id or Registry.GenerateId("component")
    self.Name = config.Name or ""
    self.Description = config.Description or ""
    self.Tooltip = config.Tooltip or self.Description
    self.Visible = true
    self.Enabled = true
    self.Value = config.Default or nil
    self.Default = config.Default or nil
    self.Callback = config.Callback or nil
    self.Parent = config.Parent or nil
    self.Type = config.Type or "Component"
    self._maid = Utilities.Maid.new()
    self._connections = {}
    self._instances = {}
    self._container = nil
    self._destroyed = false
    self._stateChanged = Utilities.Signal.new()
    Registry.Register(self)
    return self
end

function ApexComponent:SetVisible(visible)
    if self._destroyed then return end
    self.Visible = visible
    if self._container then
        self._container.Visible = visible
    end
    Apex.Signals.StateChanged:fire(self, "Visible", visible)
    self._stateChanged:fire("Visible", visible)
end

function ApexComponent:SetEnabled(enabled)
    if self._destroyed then return end
    self.Enabled = enabled
    if self._toggleVisual then
        self._toggleVisual(enabled)
    end
    Apex.Signals.StateChanged:fire(self, "Enabled", enabled)
    self._stateChanged:fire("Enabled", enabled)
end

function ApexComponent:SetParent(parent)
    self.Parent = parent
    if self._container then
        self._container.Parent = parent
    end
end

function ApexComponent:SetPosition(position)
    if self._container then
        self._container.Position = position
    end
end

function ApexComponent:GetValue()
    return self.Value
end

function ApexComponent:SetValue(value)
    self.Value = value
    self:_updateVisual()
    Apex.Signals.StateChanged:fire(self, "Value", value)
    self._stateChanged:fire("Value", value)
end

function ApexComponent:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    self._maid:destroy()
    if self._container then
        self._container:Destroy()
    end
    Registry.Unregister(self)
    Apex.Signals.StateChanged:fire(self, "Destroyed")
    self._stateChanged:fire("Destroyed")
end

function ApexComponent:_updateVisual()
    -- override in subclasses
end

function ApexComponent:_addConnection(signal, callback)
    local conn = signal:Connect(callback)
    self._maid:give(conn)
    table.insert(self._connections, conn)
    return conn
end

