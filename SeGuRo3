function Window:_setupDrag()
    local input = game:GetService("UserInputService")
    local dragging = false
    local dragStart = nil
    local startPos = nil

    self._maid:give(self._header.InputBegan:Connect(function(inputObj)
        if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
            if self._dragEnabled and not self.Maximized then
                dragging = true
                dragStart = inputObj.Position
                startPos = self._mainFrame.Position
            end
        end
    end))

    self._maid:give(self._header.InputChanged:Connect(function(inputObj)
        if dragging and (inputObj.UserInputType == Enum.UserInputType.MouseMovement or inputObj.UserInputType == Enum.UserInputType.Touch) then
            local delta = inputObj.Position - dragStart
            local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or game:GetService("GuiService"):GetScreenResolution()
            local minX = 0
            local minY = 0
            local maxX = viewport.X - self._mainFrame.AbsoluteSize.X
            local maxY = viewport.Y - self._mainFrame.AbsoluteSize.Y
            newPos = UDim2.new(0, math.clamp(newPos.X.Offset, minX, maxX), 0, math.clamp(newPos.Y.Offset, minY, maxY))
            self._mainFrame.Position = newPos
        end
    end))

    self._maid:give(self._header.InputEnded:Connect(function(inputObj)
        if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

function Window:_handleResize()
    if self._closed then return end
    self._currentScale = ResponsiveEngine.CalculateScale()
    if self._uiScale then
        self._uiScale.Scale = self._currentScale
    end
    local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or game:GetService("GuiService"):GetScreenResolution()
    local absPos = self._mainFrame.AbsolutePosition
    local absSize = self._mainFrame.AbsoluteSize
    if absPos.X + absSize.X > viewport.X or absPos.Y + absSize.Y > viewport.Y then
        self:SetPosition(UDim2.new(0.5, -self.Width/2, 0.5, -self.Height/2))
    end
end

function Window:SetTitle(title)
    self.Title = title
    self._titleLabel.Text = title
    Apex.Signals.WindowChanged:fire(self, "TitleChanged", title)
end

function Window:SetSubtitle(subtitle)
    self.Subtitle = subtitle
