function Window:OpenSearch()
    if self._searchOverlay then self._searchOverlay:Destroy() end
    local overlay = UIBuilder.CreateFrame(self._gui, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.5,
        ZIndex = 10,
        ClipsDescendants = true,
    })
    local searchBox = UIBuilder.CreateFrame(overlay, {
        Size = UDim2.new(0, 400, 0, 300),
        Position = UDim2.new(0.5, -200, 0.5, -150),
        BackgroundColor3 = ThemeEngine.Current.Surface,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    })
    UIBuilder.CreateUICorner(searchBox, 8)
    local searchInput = UIBuilder.CreateTextButton(searchBox, {
        Size = UDim2.new(1, -20, 0, 30),
        Position = UDim2.new(0, 10, 0, 10),
        Text = "",
        TextXAlignment = Enum.TextXAlignment.Left,
        PlaceholderText = "Search...",
        PlaceholderColor3 = ThemeEngine.Current.TextSecondary,
        BackgroundColor3 = ThemeEngine.Current.SurfaceSecondary,
        BackgroundTransparency = 0.2,
    })
    UIBuilder.CreateUICorner(searchInput, 4)
    local resultsFrame = UIBuilder.CreateScrollingFrame(searchBox, {
        Size = UDim2.new(1, -20, 1, -50),
        Position = UDim2.new(0, 10, 0, 50),
        CanvasSize = UDim2.new(0, 0, 0, 0),
    })
    local resultsLayout = UIBuilder.CreateUIListLayout(resultsFrame, {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 4),
    })

    local function performSearch(query)
        Utilities.InstanceHelpers.ClearChildren(resultsFrame)
        if query == "" then return end
        local found = {}
        for _, tab in ipairs(self._tabs) do
            if string.lower(tab.Name):find(string.lower(query), 1, true) then
                table.insert(found, {type="Tab", object=tab, text=tab.Name})
            end
            for _, section in ipairs(tab.Sections) do
                if string.lower(section.Name):find(string.lower(query), 1, true) then
                    table.insert(found, {type="Section", object=section, text=section.Name})
                end
                for _, comp in ipairs(section.Components) do
                    if string.lower(comp.Name):find(string.lower(query), 1, true) or (comp.Description and string.lower(comp.Description):find(string.lower(query), 1, true)) then
                        table.insert(found, {type="Component", object=comp, text=comp.Name})
                    end
                end
            end
        end
        for i, result in ipairs(found) do
            local btn = UIBuilder.CreateTextButton(resultsFrame, {
                Size = UDim2.new(1, 0, 0, 30),
                Text = result.type .. ": " .. result.text,
                LayoutOrder = i,
                BackgroundColor3 = ThemeEngine.Current.SurfaceSecondary,
                BackgroundTransparency = 0.4,
            })
            UIBuilder.CreateUICorner(btn, 4)
            btn.MouseButton1Click:Connect(function()
                if result.type == "Tab" then
                    self:SelectTab(result.object)
                elseif result.type == "Section" then
                    self:SelectTab(result.object.ParentTab)
                else
                    self:SelectTab(result.object.ParentSection.ParentTab)
                    if result.object._container then
                        local originalColor = result.object._container.BackgroundColor3
                        AnimationEngine.Tween(result.object._container, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = ThemeEngine.Current.Accent})
                        task.delay(0.5, function()
                            if result.object._container then
                                AnimationEngine.Tween(result.object._container, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = originalColor})
                            end
                        end)
                    end
                end
                overlay:Destroy()
                self._searchOverlay = nil
            end)
        end
        resultsFrame.CanvasSize = UDim2.new(0, 0, 0, #found * 34)
    end

    searchInput:GetPropertyChangedSignal("Text"):Connect(function()
        performSearch(searchInput.Text)
    end)
    searchInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            performSearch(searchInput.Text)
        end
    end)

    overlay.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if not searchBox:IsDescendantOf(input.Position) then
                overlay:Destroy()
                self._searchOverlay = nil
            end
        end
    end)

    self._searchOverlay = overlay
    self._maid:give(overlay)
end

