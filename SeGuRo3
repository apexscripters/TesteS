-- ///////////////////////////////
-- // ANIMATION ENGINE
-- ///////////////////////////////

local AnimationEngine = {
    Enabled = true,
    Speed = 1,
    ReducedMotion = false,
}

function Apex:SetAnimationSpeed(multiplier)
    AnimationEngine.Speed = math.clamp(multiplier or 1, 0.1, 10)
end

function Apex:SetAnimationsEnabled(enabled)
    AnimationEngine.Enabled = enabled
end

function Apex:SetReducedMotion(enabled)
    AnimationEngine.ReducedMotion = enabled
    if enabled then
        AnimationEngine.Speed = 0.2
    else
        AnimationEngine.Speed = 1
    end
end

function AnimationEngine.Tween(instance, tweenInfo, props)
    if not AnimationEngine.Enabled then
        for prop, value in pairs(props) do
            instance[prop] = value
        end
        return nil
    end
    local ti = tweenInfo
    if AnimationEngine.ReducedMotion then
        ti = TweenInfo.new(ti.Time * 0.2, ti.EasingStyle, ti.EasingDirection, ti.RepeatCount, ti.Reverses, ti.DelayTime)
    else
        ti = TweenInfo.new(ti.Time * AnimationEngine.Speed, ti.EasingStyle, ti.EasingDirection, ti.RepeatCount, ti.Reverses, ti.DelayTime)
    end
    local tween = game:GetService("TweenService"):Create(instance, ti, props)
    tween:Play()
    return tween
end

-- ///////////////////////////////
-- // RESPONSIVE ENGINE
-- ///////////////////////////////

local ResponsiveEngine = {
    Mobile = false,
    Scale = 1,
    BaseWidth = 1920,
    BaseHeight = 1080,
}

function ResponsiveEngine.DetectDevice()
    local screenSize = game:GetService("GuiService"):GetScreenResolution()
    local viewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or screenSize
    local minDim = math.min(viewportSize.X, viewportSize.Y)
    if minDim <= 800 or screenSize.X <= 1024 then
        ResponsiveEngine.Mobile = true
    else
        ResponsiveEngine.Mobile = false
    end
    Apex._mobile = ResponsiveEngine.Mobile
    return ResponsiveEngine.Mobile
end

function ResponsiveEngine.CalculateScale()
    local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or game:GetService("GuiService"):GetScreenResolution()
    local scaleX = viewport.X / ResponsiveEngine.BaseWidth
    local scaleY = viewport.Y / ResponsiveEngine.BaseHeight
    local base = math.min(scaleX, scaleY)
    if ResponsiveEngine.Mobile then
        base = math.max(base, 0.6)
    end
    return math.clamp(base, 0.5, 2) * Apex._scale
end

function Apex:SetScale(scale)
    self._scale = math.clamp(scale or 1, 0.5, 2)
    ResponsiveEngine.Scale = ResponsiveEngine.CalculateScale()
    for _, window in ipairs(self._windows) do
        if window._uiScale then
            window._uiScale.Scale = ResponsiveEngine.Scale
        end
    end
end

