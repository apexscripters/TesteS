local NotificationService = {
    ActiveNotifications = {},
    MaxNotifications = 5,
}

function Apex:Notify(config)
    local title = config.Title or "Apex Scripters"
    local description = config.Description or ""
    local notifType = config.Type or "Info"
    local duration = config.Duration or 3

    local colorMap = {
        Info = ThemeEngine.Current.Info,
        Success = ThemeEngine.Current.Success,
        Warning = ThemeEngine.Current.Warning,
        Error = ThemeEngine.Current.Error,
    }
    local bgColor = colorMap[notifType] or ThemeEngine.Current.Info

    local notifGui = UIBuilder.CreateGui("ApexNotification")
    local notif = UIBuilder.CreateFrame(notifGui, {
        Size = UDim2.new(0, 280, 0, 60),
        Position = UDim2.new(1, -10, 1, -70),
        BackgroundColor3 = bgColor,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    })
    UIBuilder.CreateUICorner(notif, 8)
    UIBuilder.CreateUIStroke(notif, { Color = bgColor, Thickness = 2 })

    local titleLabel = UIBuilder.CreateTextLabel(notif, {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 10, 0, 4),
        Text = title,
        Font = ThemeEngine.Current.FontBold,
        TextSize = 14,
        TextColor3 = Color3.new(1,1,1),
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local descLabel = UIBuilder.CreateTextLabel(notif, {
        Size = UDim2.new(1, -20, 0, 24),
        Position = UDim2.new(0, 10, 0, 28),
        Text = description,
        Font = ThemeEngine.Current.Font,
        TextSize = 11,
        TextColor3 = Color3.new(1,1,1),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
    })
    local closeButton = UIBuilder.CreateTextButton(notif, {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(1, -22, 0, 4),
        Text = "×",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = Color3.new(1,1,1),
        BackgroundColor3 = Color3.fromRGB(0,0,0),
        BackgroundTransparency = 0.6,
        AutoButtonColor = false,
    })
    UIBuilder.CreateUICorner(closeButton, 8)

    local progressBg = UIBuilder.CreateFrame(notif, {
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 1, -3),
        BackgroundColor3 = Color3.fromRGB(0,0,0),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
    })
    local progressFill = UIBuilder.CreateFrame(progressBg, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
    })

    local function destroyNotif()
        AnimationEngine.Tween(notif, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1})
        task.delay(0.2, function()
            notifGui:Destroy()
            for i, n in ipairs(NotificationService.ActiveNotifications) do
                if n.gui == notifGui then
                    table.remove(NotificationService.ActiveNotifications, i)
                    break
                end
            end
        end)
    end

    closeButton.MouseButton1Click:Connect(destroyNotif)

    if duration > 0 then
        local tween = AnimationEngine.Tween(progressFill, TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {Size = UDim2.new(0, 0, 1, 0)})
        if tween then
            tween.Completed:Connect(destroyNotif)
        else
            task.delay(duration, destroyNotif)
        end
    end

    local count = #NotificationService.ActiveNotifications
    if count >= NotificationService.MaxNotifications then
        local oldest = NotificationService.ActiveNotifications[1]
        if oldest then oldest.destroy() end
    end
    table.insert(NotificationService.ActiveNotifications, {gui = notifGui, notif = notif, destroy = destroyNotif})

    local yOffset = 10 + (#NotificationService.ActiveNotifications - 1) * 70
    notif.Position = UDim2.new(1, -10, 1, -yOffset - 60)

    notif.BackgroundTransparency = 1
    AnimationEngine.Tween(notif, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.2, Position = UDim2.new(1, -10, 1, -yOffset - 60)})

    return { Destroy = destroyNotif, Close = destroyNotif }
end

