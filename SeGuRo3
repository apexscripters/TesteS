-- ///////////////////////////////
-- // CLEANUP ENGINE
-- ///////////////////////////////

local CleanupEngine = {
    Tasks = {},
}

function Apex:AddCleanup(task)
    table.insert(CleanupEngine.Tasks, task)
    return task
end

function Apex:Connect(signal, callback)
    local conn = signal:Connect(callback)
    self:AddCleanup(conn)
    return conn
end

function Apex:Destroy()
    for _, window in ipairs(self._windows) do
        if window._maid then
            window._maid:destroy()
        end
        if window._gui then
            window._gui:Destroy()
        end
    end
    self._windows = {}

    for _, component in pairs(self._components) do
        component:Destroy()
    end
    self._components = {}

    for _, notif in ipairs(self._notificationQueue) do
        notif:Destroy()
    end
    self._notificationQueue = {}

    for _, dialog in ipairs(self._dialogQueue) do
        dialog:Destroy()
    end
    self._dialogQueue = {}

    for _, signal in pairs(self.Signals) do
        signal:disconnectAll()
    end

    for _, task in ipairs(CleanupEngine.Tasks) do
        if type(task) == "function" then
            task()
        elseif type(task) == "userdata" and task.Disconnect then
            task:Disconnect()
        elseif type(task) == "table" and task.Destroy then
            task:Destroy()
        end
    end
    CleanupEngine.Tasks = {}

    Apex.Signals.Destroyed:fire()
    DebugService.Log("INFO", "Apex framework destroyed.")
end

